{
  "name": "stotesel",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Локальне сховище демо-режиму. Коли задані SUPABASE_URL і
  // SUPABASE_SERVICE_ROLE_KEY, сайт працює з Supabase і цей KV не використовується.
  "kv_namespaces": [{ "binding": "DEMO_KV" }]
}
