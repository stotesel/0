---
import '../styles/site.css';
import '../styles/extra.css';
import type { Settings } from '../lib/types';
import { tel } from '../lib/site';

interface Props {
  settings: Settings;
  title: string;
  description: string;
  nextFree?: string;
  jsonLd?: object[];
  noindex?: boolean;
}
const { settings, title, description, nextFree = '', jsonLd = [], noindex = false } = Astro.props;
const origin = (settings.siteUrl || Astro.url.origin).replace(/\/$/, '');
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = `${origin}${path}`;
const [brandA, brandB] = [settings.name.slice(0, 3), settings.name.slice(3)];
// GA4 вмикається лише для коректного Measurement ID з налаштувань
const ga = /^G-[A-Z0-9]{6,14}$/.test(settings.ga4Id.trim()) ? settings.ga4Id.trim() : '';
// Приймаємо і весь тег <meta name="google-site-verification" content="…">, і лише значення
const gsv = (settings.googleVerification || '').trim().replace(/^.*content=["']([^"']+)["'].*$/s, '$1').replace(/[^\w-]/g, '');
const nav = [
  ['/servis-tesla/', 'Сервіс Tesla'],
  ['/#services', 'Послуги і ціни'],
  ['/zapchastyny/', 'Запчастини'],
  ['/#process', 'Як ми працюємо'],
  ['/#faq', 'Питання'],
  ['/kontakty/', 'Контакти'],
];
---
<!doctype html>
<html lang="uk">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#E7E9EB">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
{noindex && <meta name="robots" content="noindex, nofollow">}
{gsv && <meta name="google-site-verification" content={gsv}>}
<meta property="og:type" content="website">
<meta property="og:locale" content="uk_UA">
<meta property="og:site_name" content={settings.name}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={`${origin}/og-image.png`}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={`${settings.name}: сервіс Tesla і автосервіс у Києві`}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={`${origin}/og-image.png`}>
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png">
<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700&family=Unbounded:wght@500;700;900&display=swap" rel="stylesheet">
{ga && <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga}`}></script>}
{ga && <script is:inline define:vars={{ ga }}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',ga,{anonymize_ip:true});</script>}
{jsonLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} />)}
</head>
<body>

<header class="top" id="top">
  <div class="wrap">
    <a href="/" class="logo" aria-label={`${settings.name}, на головну`}>
      <svg viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="14" fill="#171717"/><path fill="#EFECE4" d="M11 13h26v8H19v7h18v23H11v-8h18v-7H11z"/><path fill="#F26419" d="M54 12v13l-4.6-4.6-5.6 5.6-3.9-3.9 5.6-5.6L41 12z"/></svg>
      <span>{brandA}<b>{brandB}</b></span>
    </a>
    <nav class="nav" id="nav" aria-label="Розділи сайту">
      {nav.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>
    <a class="top-phone" href={tel(settings)}>{settings.phone}<small>{nextFree || settings.phoneNote}</small></a>
    <a class="btn btn-hv btn-book" href="/#book">Записатися</a>
    <button class="burger" id="burger" aria-label="Меню" aria-expanded="false" aria-controls="nav"><span></span><span></span><span></span></button>
  </div>
</header>

<main>
  <slot />
</main>

<footer>
  <div class="wrap">
    <a href="/" class="logo"><span>{brandA}<b>{brandB}</b></span></a>
    <span>{settings.footerText}</span>
    <nav class="foot-nav" aria-label="Сторінки сайту">
      <a href="/servis-tesla/">Сервіс Tesla</a>
      <a href="/poslugy/">Послуги</a>
      <a href="/tsiny/">Ціни</a>
      <a href="/zapchastyny/">Запчастини</a>
      <a href="/kontakty/">Контакти</a>
      <a href="/polityka-konfidentsiynosti/">Політика конфіденційності</a>
    </nav>
    <span>© {new Date().getFullYear()} {settings.name}</span>
  </div>
</footer>

<div class="dock">
  <a class="btn btn-ghost" href={tel(settings)}>Подзвонити</a>
  <a class="btn btn-hv" href="/#book">Записатися</a>
</div>

<script is:inline>
  /* цілі аналітики: дзвінок, пошта, месенджери. Без GA4 (gtag відсутній) нічого не відбувається. */
  document.addEventListener('click', (e) => {
    const a = e.target.closest && e.target.closest('a[href]');
    if (!a || typeof window.gtag !== 'function') return;
    const h = a.getAttribute('href') || '';
    const method = h.startsWith('tel:') ? 'phone' : h.startsWith('mailto:') ? 'email'
      : /t\.me|viber:|wa\.me/.test(h) ? 'messenger' : /google\.com\/maps|waze\.com/.test(h) ? 'route' : '';
    if (method) window.gtag('event', 'contact_click', { method, link_url: h });
  });
  const top_ = document.getElementById('top');
  addEventListener('scroll', () => top_.classList.toggle('scrolled', scrollY > 10), { passive: true });
  const burger = document.getElementById('burger'), nav = document.getElementById('nav');
  burger.addEventListener('click', () => { const o = nav.classList.toggle('open'); burger.setAttribute('aria-expanded', o); });
  nav.addEventListener('click', (e) => { if (e.target.tagName === 'A') { nav.classList.remove('open'); burger.setAttribute('aria-expanded', false); } });
</script>
</body>
</html>
