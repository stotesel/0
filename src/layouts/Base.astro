---
// Шрифти з власного сайту, а не з Google Fonts: без зайвих з'єднань і блокування рендеру
import '@fontsource-variable/onest';
import '@fontsource-variable/unbounded';
import '../styles/site.css';
import '../styles/extra.css';
import type { Settings } from '../lib/types';
import { clip, phoneList, tel } from '../lib/site';
import { T, type Lang } from '../lib/i18n';

interface Props {
  settings: Settings;
  title: string;
  description: string;
  nextFree?: string;
  jsonLd?: object[];
  noindex?: boolean;
  lang?: Lang;
  /** Та сама сторінка іншою мовою (шлях). Є лише там, де є переклад: дає hreflang і перемикач мов. */
  alt?: string;
  ogType?: 'website' | 'article';
}
const { settings, title, nextFree = '', jsonLd = [], noindex = false, lang = 'uk', alt = '', ogType = 'website' } = Astro.props;
const description = clip(Astro.props.description);
const t = T[lang];
const phones = phoneList(settings, lang);
const home = lang === 'ru' ? '/ru/' : '/';
const altHref = alt || (lang === 'ru' ? '/' : '/ru/');
const ukPath = lang === 'uk' ? path0() : alt;
const ruPath = lang === 'ru' ? path0() : alt;
function path0() { return Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`; }
const origin = (settings.siteUrl || Astro.url.origin).replace(/\/$/, '');
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = `${origin}${path}`;
const [brandA, brandB] = [settings.name.slice(0, 3), settings.name.slice(3)];
// GA4 вмикається лише для коректного Measurement ID з налаштувань
const ga = /^G-[A-Z0-9]{6,14}$/.test(settings.ga4Id.trim()) ? settings.ga4Id.trim() : '';
// Приймаємо і весь тег <meta name="google-site-verification" content="…">, і лише значення
const gsv = (settings.googleVerification || '').trim().replace(/^.*content=["']([^"']+)["'].*$/s, '$1').replace(/[^\w-]/g, '');
const nav = t.nav;
// Попереднє завантаження сторінки, на посилання якої навели курсор або натиснули (moderate).
// Лише prefetch HTML, без prerender: скрипти, GA4 і 3D не запускаються, доки людина не перейде.
const speculation = {
  prefetch: [{
    where: { and: [
      { href_matches: '/*' },
      { not: { href_matches: ['/admin*', '/api/*'] } },
      { not: { selector_matches: '[target=_blank], [download], [rel~=nofollow]' } },
    ] },
    eagerness: 'moderate',
  }],
};
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#E7E9EB">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
{alt && <link rel="alternate" hreflang="uk" href={`${origin}${ukPath}`}>}
{alt && <link rel="alternate" hreflang="ru" href={`${origin}${ruPath}`}>}
{alt && <link rel="alternate" hreflang="x-default" href={`${origin}${ukPath}`}>}
{noindex && <meta name="robots" content="noindex, nofollow">}
{gsv && <meta name="google-site-verification" content={gsv}>}
<meta property="og:type" content={ogType}>
<meta property="og:locale" content={lang === 'ru' ? 'ru_UA' : 'uk_UA'}>
<meta property="og:site_name" content={settings.name}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={`${origin}/og-image.png`}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={`${settings.name}: сервіс Tesla і автосервіс у Києві`}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={`${origin}/og-image.png`}>
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png">
<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
{ga && <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga}`}></script>}
{ga && <script is:inline define:vars={{ ga }}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',ga,{anonymize_ip:true});</script>}
{!noindex && <script type="speculationrules" is:inline set:html={JSON.stringify(speculation)} />}
{jsonLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} />)}
</head>
<body>

<header class="top" id="top">
  <div class="wrap">
    <a href={home} class="logo" aria-label={`${settings.name}, ${t.home}`}>
      <svg viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="14" fill="#102030"/><path fill="#EFECE4" d="M11 13h26v8H19v7h18v23H11v-8h18v-7H11z"/><path fill="#F26419" d="M54 12v13l-4.6-4.6-5.6 5.6-3.9-3.9 5.6-5.6L41 12z"/></svg>
      <span>{brandA}<b>{brandB}</b></span>
    </a>
    <nav class="nav" id="nav" aria-label={t.sections} popover>
      {nav.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>
    <a class="lang-sw" href={altHref} hreflang={lang === 'ru' ? 'uk' : 'ru'} aria-label={t.switchLabel} title={t.switchLabel}>{t.switchTo}</a>
    <a class={`top-phone${phones.length > 1 ? ' top-call' : ''}`} href={tel(settings)}>{phones.length > 1
      ? <span class="tc-btn"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg><span class="tc-t"><b>{t.callFull}</b><small>{nextFree || settings.phoneNote}</small></span></span>
      : <>{settings.phone}<small>{nextFree || settings.phoneNote}</small></>}</a>
    <a class="btn btn-hv btn-book" href={`${home}#book`}>{t.book}</a>
    <button class="burger" id="burger" popovertarget="nav" aria-label={t.menu} aria-expanded="false" aria-controls="nav"><span></span><span></span><span></span></button>
  </div>
  <span class="top-rule" aria-hidden="true"></span>
</header>

<main>
  <slot />
</main>

<footer>
  <div class="wrap">
    <a href={home} class="logo"><span>{brandA}<b>{brandB}</b></span></a>
    <span>{settings.footerText}</span>
    <nav class="foot-nav" aria-label={t.pages}>
      {t.foot.map(([href, label]) => <a href={href}>{label}</a>)}
      {lang === 'uk' && <a href={altHref} hreflang="ru">Русская версия</a>}
    </nav>
    <span>© {new Date().getFullYear()} {settings.name}</span>
  </div>
</footer>

<div class="dock">
  <a class="btn btn-ghost call-pulse" href={tel(settings)}><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>{t.callFull}</a>
  <a class="btn btn-hv" href={`${home}#book`}>{t.book}</a>
</div>

{phones.length > 1 && (
  <dialog class="phone-pick" id="phone-pick" aria-labelledby="phone-pick-t" closedby="any">
    <div class="pp-box">
      <div class="pp-head"><b id="phone-pick-t">{t.pickPhone}</b><button type="button" class="pp-x" data-pp-close aria-label={t.close}>×</button></div>
      {phones.map((p, i) => <a class="pp-row" href={`tel:${p.e164}`} autofocus={i === 0}><span>{p.name}</span><b>{p.phone}</b></a>)}
    </div>
  </dialog>
)}

<script is:inline>
  /* вибір номера: усі посилання tel: відкривають нативне модальне вікно, якщо номерів кілька.
     Esc, фокус усередині й неактивна сторінка під вікном — від браузера (showModal).
     Без JS або без підтримки <dialog> посилання просто дзвонить на основний номер. */
  (function () {
    const pick = document.getElementById('phone-pick');
    if (!pick || typeof pick.showModal !== 'function') return;
    let from = null;
    document.addEventListener('click', (e) => {
      const a = e.target.closest && e.target.closest('a[href^="tel:"]');
      if (a && !pick.contains(a)) { e.preventDefault(); from = a; if (!pick.open) pick.showModal(); }
    });
    // клік по затемненню (ціль — сам dialog, бо вміст займає його повністю) і кнопка ×; запасний варіант для closedby у Safari
    pick.addEventListener('click', (e) => { if (e.target === pick || e.target.closest('[data-pp-close]')) pick.close(); });
    pick.addEventListener('close', () => { if (from && from.focus) from.focus(); from = null; });
  })();
</script>
<script is:inline>
  /* цілі аналітики: дзвінок, пошта, месенджери. Без GA4 (gtag відсутній) нічого не відбувається. */
  document.addEventListener('click', (e) => {
    const a = e.target.closest && e.target.closest('a[href]');
    if (!a || typeof window.gtag !== 'function') return;
    const h = a.getAttribute('href') || '';
    const method = h.startsWith('tel:') ? 'phone' : h.startsWith('mailto:') ? 'email'
      : /t\.me|viber:|wa\.me/.test(h) ? 'messenger' : /google\.com\/maps|waze\.com/.test(h) ? 'route' : '';
    if (method) window.gtag('event', 'contact_click', { method, link_url: h });
  });
  /* лінія під шапкою: у нових браузерах її вмикає CSS (scroll-state), тут — запасний варіант */
  if (!(window.CSS && CSS.supports('container-type', 'scroll-state'))) {
    const top_ = document.getElementById('top');
    addEventListener('scroll', () => top_.classList.toggle('scrolled', scrollY > 10), { passive: true });
  }
  /* меню: popover (Esc і клік поза меню закривають його самі); без підтримки popover — клас .open, як раніше */
  const burger = document.getElementById('burger'), nav = document.getElementById('nav');
  const pop = typeof nav.showPopover === 'function';
  const closeNav = () => { if (pop) { if (nav.matches(':popover-open')) nav.hidePopover(); } else { nav.classList.remove('open'); burger.setAttribute('aria-expanded', 'false'); } };
  if (pop) {
    nav.addEventListener('toggle', (e) => burger.setAttribute('aria-expanded', String(e.newState === 'open')));
    matchMedia('(min-width:1201px)').addEventListener('change', (m) => { if (m.matches) closeNav(); });
  } else {
    nav.removeAttribute('popover'); burger.removeAttribute('popovertarget');
    burger.addEventListener('click', () => { const o = nav.classList.toggle('open'); burger.setAttribute('aria-expanded', String(o)); });
  }
  nav.addEventListener('click', (e) => { if (e.target.closest('a')) closeNav(); });
</script>
</body>
</html>
