---
// Окрема SEO-сторінка на кожну послугу: /planove-to/, /remont-khodovoi/ тощо.
import { marked } from 'marked';
import Base from '../layouts/Base.astro';
import Booking from '../components/blocks/Booking.astro';
import { areaServed, breadcrumbLd, loadSite, price, tel } from '../lib/site';
import { serviceTexts } from '../lib/serviceTexts';
import { articlesFor } from '../lib/articles';
import { TESLA_MODELS } from '../lib/teslaModels';
import { RU_SERVICES } from '../lib/ru/services';

const { settings, blocks, services, nextFree } = await loadSite();
const s = services.find((x) => x.slug === Astro.params.slug);
if (!s) return Astro.rewrite('/404');

const origin = (settings.siteUrl || Astro.url.origin).replace(/\/$/, '');
const city = settings.city === 'Київ' ? 'Києві' : settings.city;
const hasPrice = s.price_from > 0;
const priceStr = hasPrice ? `від ${price(s.price_from)} грн` : 'ціна за запитом';
const title = s.seo_title || `${s.title} у ${city} — ${priceStr} | ${settings.name}`;
const body = s.body?.trim() || serviceTexts[s.slug] || '';
const lcFirst = (t: string) => (/^[A-ZА-ЯІЇЄҐ]{2}/.test(t) ? t : t.charAt(0).toLowerCase() + t.slice(1));
const description = s.seo_description || `${s.title} в автосервісі ${settings.name}: ${lcFirst(s.summary)}. ${hasPrice ? `Від ${price(s.price_from)} грн, ` : ''}${s.duration}. Запис онлайн або за телефоном ${settings.phone}.`;
const booking = blocks.find((b) => b.type === 'booking')?.data ?? {};
// Внутрішні посилання: статті, що згадують цю послугу, і моделі Tesla, для яких вона типова
const related = articlesFor(`/${s.slug}/`).slice(0, 6);
const models = TESLA_MODELS.filter((m) => s.kind === 'ev' || m.services.includes(s.slug));
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.title,
  description: s.summary,
  areaServed: areaServed(settings),
  provider: { '@id': `${origin}/#autorepair` },
  ...(hasPrice ? { offers: { '@type': 'Offer', priceCurrency: 'UAH', priceSpecification: { '@type': 'PriceSpecification', minPrice: s.price_from, priceCurrency: 'UAH' } } } : {}),
};
---
<Base settings={settings} title={title} description={description} nextFree={nextFree} alt={RU_SERVICES[s.slug] ? `/ru/${s.slug}/` : ''}
  jsonLd={[serviceLd, breadcrumbLd(origin, [['Головна', '/'], ['Послуги', '/poslugy/'], [s.title, `/${s.slug}/`]])]}>
  <div class="page-head"><div class="wrap">
    <nav class="crumbs" aria-label="Навігація"><a href="/">Головна</a><span>/</span><a href="/poslugy/">Послуги</a><span>/</span><span>{s.title}</span></nav>
    <h1>{s.title}</h1>
    <p class="lead">{s.summary}</p>
  </div></div>
  <div class="page-body"><div class="wrap svc">
    <div class="svc-card">
      {s.includes.length > 0 && (
        <>
          <h2>Що входить</h2>
          <ul>{s.includes.map((x) => <li>{x}</li>)}</ul>
        </>
      )}
      {body && <div class="prose" set:html={marked.parse(body)} />}
    </div>
    <aside class="svc-side">
      <div><div class="k">Вартість роботи</div><div class="v">{hasPrice ? <><small>від</small>{price(s.price_from)} грн</> : 'За запитом'}</div></div>
      <div><div class="k">Тривалість</div><div class="v">{s.duration}</div></div>
      <p class="k">{hasPrice ? 'Ціна без запчастин. Точну суму фіксуємо в кошторисі до початку робіт.' : 'Вартість залежить від авто й розміру коліс. Назвемо точну суму телефоном або під час запису.'}</p>
      <a class="btn btn-hv" href="#book">Обрати час візиту</a>
      <a class="btn btn-ghost" href={tel(settings)}>{settings.phone}</a>
    </aside>
  </div></div>
  {models.length > 0 && (
    <div class="page-body"><div class="wrap">
      <h2 class="svc-related">{s.title}: Tesla</h2>
      <div class="cards">
        {models.map((m) => <a class="card-i" href={`/servis-tesla/${m.slug}/`}><h3>Tesla {m.name}</h3><p>{m.lead}</p></a>)}
      </div>
    </div></div>
  )}
  {related.length > 0 && (
    <div class="page-body"><div class="wrap">
      <h2 class="svc-related">Корисні статті</h2>
      <div class="cards">
        {related.map((a) => <a class="card-i" href={`/statti/${a.slug}/`}><h3>{a.title}</h3><p>{a.lead}</p></a>)}
      </div>
    </div></div>
  )}
  <Booking data={booking} settings={settings} services={services} tight preselect={s.title} />
</Base>
<style>
  .svc-related{font:600 26px/1.2 var(--display);letter-spacing:-.02em;margin-bottom:20px}
  .svc-card :global(table){width:100%;border-collapse:collapse;margin:12px 0 16px;font-size:16px;overflow-wrap:anywhere}
  .svc-card :global(th), .svc-card :global(td){text-align:left;padding:10px 8px;border-bottom:1px solid rgba(0,0,0,.1);vertical-align:top}
  .svc-card :global(th){font-weight:600}
</style>

