---
// Окрема SEO-сторінка на кожну послугу: /planove-to/, /remont-khodovoi/ тощо.
import { marked } from 'marked';
import Base from '../layouts/Base.astro';
import Booking from '../components/blocks/Booking.astro';
import { breadcrumbLd, loadSite, price, tel } from '../lib/site';

const { settings, blocks, services, nextFree } = await loadSite();
const s = services.find((x) => x.slug === Astro.params.slug);
if (!s) return Astro.rewrite('/404');

const origin = (settings.siteUrl || Astro.url.origin).replace(/\/$/, '');
const city = settings.city === 'Київ' ? 'Києві' : settings.city;
const title = s.seo_title || `${s.title} у ${city} — від ${price(s.price_from)} грн | ${settings.name}`;
const description = s.seo_description || `${s.title} в автосервісі ${settings.name}: ${s.summary.toLowerCase()}. Від ${price(s.price_from)} грн, ${s.duration}. Запис онлайн або за телефоном ${settings.phone}.`;
const booking = blocks.find((b) => b.type === 'booking')?.data ?? {};
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.title,
  description: s.summary,
  areaServed: settings.city,
  provider: { '@id': `${origin}/#autorepair` },
  offers: { '@type': 'Offer', priceCurrency: 'UAH', priceSpecification: { '@type': 'PriceSpecification', minPrice: s.price_from, priceCurrency: 'UAH' } },
};
---
<Base settings={settings} title={title} description={description} nextFree={nextFree}
  jsonLd={[serviceLd, breadcrumbLd(origin, [['Головна', '/'], ['Послуги', '/poslugy/'], [s.title, `/${s.slug}/`]])]}>
  <div class="page-head"><div class="wrap">
    <nav class="crumbs" aria-label="Навігація"><a href="/">Головна</a><span>/</span><a href="/poslugy/">Послуги</a><span>/</span><span>{s.title}</span></nav>
    <h1>{s.title}</h1>
    <p class="lead">{s.summary}</p>
  </div></div>
  <div class="page-body"><div class="wrap svc">
    <div class="svc-card">
      {s.includes.length > 0 && (
        <>
          <h2>Що входить</h2>
          <ul>{s.includes.map((x) => <li>{x}</li>)}</ul>
        </>
      )}
      {s.body && <div class="prose" set:html={marked.parse(s.body)} />}
    </div>
    <aside class="svc-side">
      <div><div class="k">Вартість роботи</div><div class="v"><small>від</small>{price(s.price_from)} грн</div></div>
      <div><div class="k">Тривалість</div><div class="v">{s.duration}</div></div>
      <p class="k">Ціна без запчастин. Точну суму фіксуємо в кошторисі до початку робіт.</p>
      <a class="btn btn-hv" href="#book">Обрати час візиту</a>
      <a class="btn btn-ghost" href={tel(settings)}>{settings.phone}</a>
    </aside>
  </div></div>
  <Booking data={booking} settings={settings} services={services} tight preselect={s.title} />
</Base>
