---
import { marked } from 'marked';
import Base from '../../layouts/Base.astro';
import Booking from '../../components/blocks/Booking.astro';
import Photo from '../../components/Photo.astro';
import { breadcrumbLd, loadSite, callText, tel } from '../../lib/site';
import { ALL_ARTICLES, article } from '../../lib/articles';
import { reviewDate } from '../../lib/reviews';

const a = article(Astro.params.slug ?? '');
if (!a) return Astro.rewrite('/404');

const { settings, blocks, services, nextFree, photos } = await loadSite();
const origin = (settings.siteUrl || Astro.url.origin).replace(/\/$/, '');
const booking = blocks.find((b) => b.type === 'booking')?.data ?? {};
const others = ALL_ARTICLES.filter((x) => x.slug !== a.slug && (x.category ?? 'tesla') === (a.category ?? 'tesla')).slice(0, 6);
const img = photos[`article-${a.slug}`]?.url;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: a.title,
  description: a.description,
  datePublished: a.date,
  dateModified: a.date,
  inLanguage: 'uk',
  mainEntityOfPage: `${origin}/statti/${a.slug}/`,
  image: img || `${origin}/og-image.png`,
  author: { '@type': 'Organization', name: settings.name, url: `${origin}/` },
  publisher: { '@id': `${origin}/#autorepair` },
};
---
<Base ogType="article" settings={settings} title={a.seoTitle.length + settings.name.length + 3 <= 65 ? `${a.seoTitle} | ${settings.name}` : a.seoTitle} description={a.description} nextFree={nextFree}
  jsonLd={[articleLd, breadcrumbLd(origin, [['Головна', '/'], ['Статті', '/statti/'], [a.title, `/statti/${a.slug}/`]])]}>
  <div class="page-head"><div class="wrap">
    <nav class="crumbs" aria-label="Навігація"><a href="/">Головна</a><span>/</span><a href="/statti/">Статті</a><span>/</span><span>{a.title}</span></nav>
    <h1>{a.title}</h1>
    <p class="lead">{a.lead}</p>
  </div></div>

  <div class="page-body"><div class="wrap svc">
    <article class="svc-card">
      <p class="art-date">{settings.name} · {reviewDate(a.date)}</p>
      <div class="prose" set:html={marked.parse(a.body)} />
    </article>
    <aside class="svc-side">
      <Photo photos={photos} slot={`article-${a.slug}`} alt={a.title} eager />
      <div class="k">Читайте також</div>
      <ul class="art-links">
        {a.links.map(([t, h]) => <li><a href={h}>{t}</a></li>)}
      </ul>
      <a class="btn btn-hv" href="#book">Записатися на діагностику</a>
      <a class="btn btn-ghost" href={tel(settings)}>{callText(settings, 'uk')}</a>
    </aside>
  </div></div>

  <div class="page-body"><div class="wrap">
    <h2 class="svc-related">Інші статті</h2>
    <div class="cards">
      {others.map((o) => <a class="card-i" href={`/statti/${o.slug}/`}><h3>{o.title}</h3><p>{o.lead}</p></a>)}
    </div>
  </div></div>

  <Booking data={booking} settings={settings} services={services} tight />
</Base>

<style>
  .svc-related{font:600 26px/1.2 var(--display);letter-spacing:-.02em;margin-bottom:20px}
  .art-date{color:var(--ink-soft);font-size:14px}
  .art-links{list-style:none;display:grid;gap:10px}
  .art-links a{color:var(--chalk);text-decoration:underline;text-underline-offset:3px}
</style>
