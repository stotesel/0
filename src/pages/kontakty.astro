---
import { marked } from 'marked';
import Base from '../layouts/Base.astro';
import Contacts from '../components/Contacts.astro';
import { addressLine, autoRepairLd, breadcrumbLd, districtList, loadSite } from '../lib/site';

const { settings, services, nextFree } = await loadSite();
const origin = (settings.siteUrl || Astro.url.origin).replace(/\/$/, '');
// «Нивки, Виноградар» → «біля Нивок і Виноградаря» не відмінюємо автоматично, тому пишемо через тире
const d = districtList(settings);
const near = d.length ? ` — ${d.join(', ')}` : '';
const title = `Контакти ${settings.name}: автосервіс і шиномонтаж${near}`;
const description = `${settings.name}: ${addressLine(settings)}${d.length ? ` (${d.join(', ')})` : ''}. ${settings.hoursText}. Телефон ${settings.phone}. Маршрут у Google Maps і Waze.`;
const directions = settings.directions?.trim() ? (marked.parse(settings.directions) as string) : '';
---
<Base settings={settings} title={title} description={description} nextFree={nextFree}
  jsonLd={[autoRepairLd(settings, services, origin), breadcrumbLd(origin, [['Головна', '/'], ['Контакти', '/kontakty/']])]}>
  <div class="page-head"><div class="wrap">
    <nav class="crumbs" aria-label="Навігація"><a href="/">Головна</a><span>/</span><span>Контакти</span></nav>
  </div></div>
  <Contacts title="Як нас знайти" settings={settings} tight heading="h1" />
  {directions && (
    <div class="page-body"><div class="wrap">
      <div class="svc-card prose" set:html={directions} />
    </div></div>
  )}
</Base>
