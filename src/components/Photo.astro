---
// Квадратне фото з адмінки. Поки його не завантажили, показуємо білу заглушку.
import type { Photos } from '../lib/types';
interface Props { photos: Photos; slot: string; alt: string; eager?: boolean }
const { photos, slot, alt, eager = false } = Astro.props;
const p = photos[slot];
---
{p?.url
  ? <img class="ph" src={p.url} alt={p.alt || alt} width="1200" height="1200" loading={eager ? 'eager' : 'lazy'} decoding="async">
  : <div class="ph ph-empty" role="img" aria-label={alt}></div>}
