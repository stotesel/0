---
import type { Settings } from '../lib/types';
import { addressLine, mapLinks, tel } from '../lib/site';
interface Props { title: string; settings: Settings; tight?: boolean; heading?: 'h1' | 'h2' }
const { title, settings: s, tight = false, heading: H = 'h2' } = Astro.props;
const m = mapLinks(s);
const digits = (v: string) => v.replace(/\D/g, '');
---
<section id="contacts" style={tight ? 'padding-top:24px' : undefined}>
  <div class="wrap contact">
    <div class="c-card">
      <H>{title}</H>
      <div class="c-item"><div class="k">Адреса</div><div class="v">{s.street}<br>{s.city}, {s.postalCode}</div></div>
      <div class="c-item"><div class="k">Телефон</div><a class="v" href={tel(s)}>{s.phone}</a></div>
      {s.email && <div class="c-item"><div class="k">Пошта</div><a class="v" href={`mailto:${s.email}`}>{s.email}</a></div>}
      <div class="c-item"><div class="k">Графік</div><div class="v">{s.hoursText}<br>{s.hoursNote}</div></div>
      {(s.telegram || s.viber || s.whatsapp) && (
        <div class="c-item">
          <div class="k">Месенджери</div>
          <div class="msgr">
            {s.telegram && <a class="btn btn-ghost" target="_blank" rel="noopener" href={`https://t.me/${s.telegram.replace(/^@/, '')}`}>Telegram</a>}
            {s.viber && <a class="btn btn-ghost" href={`viber://chat?number=%2B${digits(s.viber)}`}>Viber</a>}
            {s.whatsapp && <a class="btn btn-ghost" target="_blank" rel="noopener" href={`https://wa.me/${digits(s.whatsapp)}`}>WhatsApp</a>}
          </div>
        </div>
      )}
      <div class="c-btns">
        <a class="btn btn-ink" target="_blank" rel="noopener" href={m.google}>Маршрут у Google Maps</a>
        <a class="btn btn-ghost" target="_blank" rel="noopener" href={m.waze}>Waze</a>
      </div>
    </div>
    <div class="map">
      <iframe title={`Карта: ${addressLine(s)}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" src={m.embed}></iframe>
    </div>
  </div>
</section>
