---
// Перший екран. Ліва частина з макета stotesel.html; права: 3D-модель Tesla Model 3
// (src/scripts/tesla3d.js), на якій підсвічується вибраний вузол. Вузол веде на свою послугу з ціною з бази.
// Плоска гравюра (scripts/engrave.mjs) лишається заставкою, поки вантажиться модель, і запасним варіантом без WebGL 2.
import type { Service, Settings } from '../../lib/types';
import { callText, price, tel } from '../../lib/site';
import { defaultZones } from '../../lib/seed';
import { lp, type Lang } from '../../lib/i18n';
interface Props { data: Record<string, any>; settings: Settings; services: Service[]; lang?: Lang }
const { data: d, settings, services, lang = 'uk' } = Astro.props;
const ru = lang === 'ru';
const [brandA, brandB] = [settings.name.slice(0, 3), settings.name.slice(3)];
const icons = [
  '<path d="M9 12l2 2 4-4"/><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/>',
  '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  '<path d="M21 8l-9-5-9 5 9 5z"/><path d="M3 8v8l9 5 9-5V8"/>',
];
// Частини авто, які вміє підсвічувати 3D-модель (деталі й ракурси — у src/scripts/tesla3d.js).
const PARTS = new Set(['battery', 'chassis', 'electronics', 'glass', 'charge', 'climate', 'cooling', 'tyres', 'alignment', 'maintenance', 'brakes', 'aircon']);
type Zone = { title: string; text: string; slug: string; part: string };
const saved = ((d.zones ?? []) as Zone[]).filter((z) => PARTS.has(z.part));
// у збережених в адмінці вузлах можуть бути лише старі шість — нові додаємо в кінець
const base = saved.length ? saved : defaultZones;
const zones = [...base, ...(ru ? [] : defaultZones.filter((z) => !base.some((b) => b.part === z.part)))].map((z) => {
  const s = services.find((x) => x.slug === z.slug);
  return { ...z, text: z.text || s?.summary || '', service: s };
});
---
<section class="hero" style="padding-bottom:0">
  <div class="wrap">
    <div class="wordmark" aria-hidden="true">{brandA}<span class="t">{brandB}</span></div>
    <div class="hero-tags" aria-label={ru ? 'Что ремонтируем' : 'Що ремонтуємо'}>
      {(d.tags ?? []).map((t: string) => <span>{t}</span>)}
    </div>

    <div class="hero-grid">
      <div class="hero-copy">
        <h1>{d.title}</h1>
        <p>{d.text}</p>
        <div class="hero-cta">
          <a class="btn btn-hv" href="#book">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
            {d.button}
          </a>
          <a class="btn btn-ghost call-pulse" href={tel(settings)}>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
            {callText(settings, ru ? 'ru' : 'uk')}
          </a>
        </div>
        <ul class="facts">
          {(d.facts ?? []).map((f: any, i: number) => (
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons[i % icons.length]} />
              <span><b>{f.title}</b> {f.text}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="bay tesla" id="tesla" data-z="0" data-part={zones[0].part}>
        <div class="tesla-head">
          <span class="eyebrow">{d.specLabel ?? 'Спеціалізація'}</span>
          <h2>{d.specTitle ?? 'Ремонт і обслуговування Tesla'}</h2>
          <p>{d.specText ?? 'Model S, 3, X та Y. Натисніть на вузол, щоб побачити, що ми з ним робимо.'} <a href={lp(lang, '/servis-tesla/')}>{ru ? 'Всё о сервисе Tesla' : 'Усе про сервіс Tesla'}</a></p>
        </div>

        <div class="tesla-stage">
          <img class="eng" src="/img/tesla-engraving.webp" srcset="/img/tesla-engraving-700.webp 700w, /img/tesla-engraving.webp 1200w" sizes="(max-width: 760px) 100vw, 640px" width="1200" height="549" alt={ru ? 'Tesla, вид сверху, гравюра' : 'Tesla, вид зверху, гравюра'} fetchpriority="high">
          <canvas class="car3d" aria-label={ru ? 'Tesla Model 3 в 3D. Потяните, чтобы повернуть; нажмите на деталь, чтобы выбрать узел.' : 'Tesla Model 3 у 3D. Потягніть, щоб повернути; натисніть на деталь, щоб вибрати вузол.'}></canvas>
          {zones.map((z, i) => (
            <button type="button" class="hot" data-i={i} data-part={z.part} aria-label={z.title} aria-pressed={i === 0 ? 'true' : 'false'}>{i + 1}</button>
          ))}
          <a class="car3d-credit" href="https://sketchfab.com/3d-models/tesla-model-3-2024-36c52f3f89f6439c90310f14e8ff33f2" target="_blank" rel="noopener nofollow">3D: RBLXSupercars · CC BY 4.0</a>
        </div>

        <div class="tesla-chips" role="group" aria-label={ru ? 'Узлы автомобиля' : 'Вузли автомобіля'}>
          {zones.map((z, i) => <button type="button" data-i={i} data-part={z.part} aria-pressed={i === 0 ? 'true' : 'false'}><b>{i + 1}</b>{z.title}</button>)}
        </div>

        <div class="tesla-info" aria-live="polite">
          {zones.map((z, i) => (
            <div class:list={['tesla-panel', { on: i === 0 }]} data-i={i}>
              <div>
                <h3>{z.title}</h3>
                <p>{z.text}</p>
              </div>
              {z.service && (
                <div class="tesla-cost">
                  <span>{z.service.price_from > 0 ? <><small>{ru ? 'от' : 'від'}</small>{price(z.service.price_from)} грн</> : <small>{ru ? 'цена по запросу' : 'ціна за запитом'}</small>}</span>
                  <a href={lp(lang, `/${z.service.slug}/`)}>{ru ? 'Подробнее' : 'Детальніше'}</a>
                </div>
              )}
            </div>
          ))}
        </div>
        <p class="bay-note">{d.note ?? 'Також обслуговуємо бензинові, дизельні та гібридні авто.'} <a href="#services">{ru ? 'Все услуги и цены' : 'Усі послуги й ціни'}</a></p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const root = document.getElementById('tesla');
    const n = root.querySelectorAll('.tesla-panel').length;
    let timer = null;
    function select(i) {
      root.dataset.z = i;
      root.dataset.part = root.querySelector(`.hot[data-i="${i}"]`).dataset.part; // 3D-модель стежить за цим атрибутом
      root.querySelectorAll('.hot, .tesla-chips button').forEach((b) => b.setAttribute('aria-pressed', String(+b.dataset.i === i)));
      root.querySelectorAll('.tesla-panel').forEach((p) => p.classList.toggle('on', +p.dataset.i === i));
      // активна кнопка завжди в полі зору; гортаємо лише сам ряд, а не сторінку
      const chips = root.querySelector('.tesla-chips'), chip = chips.querySelector(`[data-i="${i}"]`);
      chips.scrollTo({ left: chip.offsetLeft - (chips.clientWidth - chip.offsetWidth) / 2, behavior: 'smooth' });
    }
    root.addEventListener('click', (e) => {
      const b = e.target.closest('button[data-i]');
      if (!b) return;
      clearInterval(timer); // після першого вибору вузли більше не перемикаються самі
      select(+b.dataset.i);
    });
    root.addEventListener('tesla:interact', () => clearInterval(timer)); // користувач крутить модель
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && n > 1) {
      timer = setInterval(() => select((+root.dataset.z + 1) % n), 4000);
    }

    /* великий напис завжди точно на всю ширину контейнера */
    const wm = document.querySelector('.wordmark');
    function fitWord() { wm.style.fontSize = '100px'; const cs = getComputedStyle(wm.parentElement), W = wm.parentElement.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight); wm.style.fontSize = Math.min(220, 100 * W / wm.scrollWidth * 0.995) + 'px'; }
    addEventListener('resize', fitWord); fitWord();
    document.fonts.ready.then(fitWord);
  })();
</script>
<script src="../../scripts/tesla3d.js"></script>
