---
// Прайс з макета: фільтр за типом авто, на телефоні перші 6 позицій + кнопка.
import type { Service } from '../lib/types';
import { price } from '../lib/site';
import { T, lp, type Lang } from '../lib/i18n';
interface Props { services: Service[]; foot?: string; collapsed?: boolean; lang?: Lang }
const { services, foot = '', collapsed = true, lang = 'uk' } = Astro.props;
const t = T[lang];
const KIND: Record<string, string> = { ev: 'EV', hyb: t.kindHyb, ice: t.kindIce };
---
<div class="tabs" role="group" aria-label={t.filter} id="tabs" data-show={t.showAll} data-hide={t.collapse}>
  <button type="button" data-f="all" aria-pressed="true">{t.allServices}</button>
  <button type="button" data-f="ice" aria-pressed="false">{t.ice}</button>
  <button type="button" data-f="hyb" aria-pressed="false">{t.hyb}</button>
  <button type="button" data-f="ev" aria-pressed="false">{t.ev}</button>
</div>
<div class:list={['price', { collapsed }]} id="price">
  {services.map((s, i) => (
    <div class:list={['row', { extra: collapsed && i >= 6 }]} data-k={s.kind}>
      <h3><a href={lp(lang, `/${s.slug}/`)}>{s.title}</a>{s.kind !== 'all' && <span class="kind">{KIND[s.kind]}</span>}</h3>
      <p>{s.summary}</p>
      <div class="cost">{s.price_from > 0 ? <><small>{t.from}</small>{price(s.price_from)} {t.uah}</> : <small>{t.onRequest}</small>}</div>
      <div class="time">{s.duration}</div>
    </div>
  ))}
</div>
{collapsed && services.length > 6 && (
  <button type="button" class="btn btn-ghost more-btn" id="moreBtn" aria-expanded="false" aria-controls="price">{t.showAll}</button>
)}
{foot && <p class="price-foot">{foot}</p>}

<script is:inline>
  (() => {
    const priceEl = document.getElementById('price'), moreBtn = document.getElementById('moreBtn'), tabs = document.getElementById('tabs');
    moreBtn?.addEventListener('click', () => {
      const c = priceEl.classList.toggle('collapsed');
      moreBtn.setAttribute('aria-expanded', !c);
      moreBtn.textContent = c ? tabs.dataset.show : tabs.dataset.hide;
      if (c) priceEl.scrollIntoView({ block: 'start' });
    });
    window.setFilter = (f) => {
      if (moreBtn) {
        if (f !== 'all') { priceEl.classList.remove('collapsed'); moreBtn.style.display = 'none'; }
        else moreBtn.style.removeProperty('display');
      }
      tabs.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', b.dataset.f === f));
      priceEl.querySelectorAll('.row').forEach((r) => {
        const k = r.dataset.k;
        r.classList.toggle('hide', !(f === 'all' || k === 'all' || k === f || (f === 'hyb' && k === 'ice')));
      });
    };
    tabs.addEventListener('click', (e) => { const b = e.target.closest('button'); if (b) window.setFilter(b.dataset.f); });
  })();
</script>
